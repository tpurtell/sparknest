# sparknest node configuration for a container (packaging/docker): an
# off-grid host (ADR-047) that stores and serves, on a NAS or any Docker
# host. It joins as a non-voting learner over the LAN; the others dial it at
# `addr` below (the container uses the host's network).
#
# Before its first start, add it from a running host of the cluster:
#   nest cluster add 12 172.22.1.10:7400 --offgrid
# then list it in `members` here and on every other host (as voter = false).

[node]
# An id no host has had: `nest cluster ls` shows the ones in use, and a
# removed host's id stays retired (its old store record keeps the name).
id = 12
name = "aviary"
role = "offgrid"
# Inside the container; the folder mounted there holds everything, unless
# data_dir below puts the copies on other disks.
state_dir = "/srv/sparknest"
# Optional (ADR-094): this host's copies (objects/, staging/) in a folder of
# their own, mounted at /srv/sparknest-data (DATA in compose.yaml): bulk
# data on the big disks, metadata and the rest on fast ones. See README.md
# for moving an existing host's copies there.
# data_dir = "/srv/sparknest-data"
# Copies written into this host's disks at once (default 8, for SSDs). On
# spinning disks 2: each file lands in long runs, and the disk never waits.
# disk_transfers = 2
# No mountpoint: the namespace is not mounted in the container (a host that
# only stores and serves needs none). To mount it, see compose.yaml.
listen = "0.0.0.0:7400"
api_listen = "0.0.0.0:7401"
# Free space kept on the state folder's filesystem for metadata and the
# Raft log; on a shared NAS pool, also what the rest of the pool keeps.
data_reserve_gib = 64

[cluster]
name = "sparknest"
secret_file = "/srv/sparknest/cluster.secret"
# Every voting host at its LAN address, and this host as a learner.
members = [
  { id = 1, name = "raptor",  addr = "172.22.2.12:7400" },
  { id = 2, name = "ostrich", addr = "172.22.2.1:7400" },
  { id = 12, name = "aviary", addr = "172.22.1.10:7400", voter = false },
]
