# The real deployment. Use with:
#   SPARKNEST_ENV=scripts/cluster-main.env scripts/deploy-cluster.sh
#   SPARKNEST_ENV=scripts/cluster-main.env scripts/cluster.sh bootstrap
# Needs the root checklist in docs/ENVIRONMENT.md (/srv/sparknest and
# /mnt/sparknest owned by the user). Runs beside the trial: its own cluster
# name, secret, ports and paths. See docs/MIGRATION.md.
SPARKNEST_HOSTS=(
  "raptor:1:10.55.0.22:x86_64"
  "ostrich:2:10.55.0.1:aarch64"
  "dodo:3:10.55.0.2:aarch64"
  "emu:4:10.55.0.3:aarch64"
  "kiwi:5:10.55.0.4:aarch64"
  "rhea:6:10.55.0.5:aarch64"
  "moa:7:10.55.0.6:aarch64"
)
SPARKNEST_ARM_BUILDER=ostrich
SPARKNEST_ARM_BUILD_DIR='~/build/sparknest'
SPARKNEST_CLUSTER=main
SPARKNEST_STATE_DIR=/srv/sparknest
SPARKNEST_MOUNT=/mnt/sparknest
SPARKNEST_PORT=7400
SPARKNEST_API_PORT=7401
SPARKNEST_BIN_DIR='~/.local/lib/sparknest-main'
