# Hosts for trial deployment. Sourced by scripts/*.sh.
# name:node_id:rail0_ip:arch
SPARKNEST_HOSTS=(
  "raptor:1:10.55.0.22:x86_64"
  "ostrich:2:10.55.0.1:aarch64"
  "dodo:3:10.55.0.2:aarch64"
  "emu:4:10.55.0.3:aarch64"
  "kiwi:5:10.55.0.4:aarch64"
  "rhea:6:10.55.0.5:aarch64"
  "moa:7:10.55.0.6:aarch64"
)
# LAN addresses (172.22.0.0/16, 10GbE): how off-grid hosts reach the fabric
# hosts (ADR-047). name:lan_ip
SPARKNEST_LAN=(
  "raptor:172.22.2.12"
  "ostrich:172.22.2.1"
  "dodo:172.22.2.2"
  "emu:172.22.2.3"
  "kiwi:172.22.2.4"
  "rhea:172.22.2.5"
  "moa:172.22.2.6"
)
# Off-grid hosts (LAN only, learners that dial out). name:node_id:lanes
SPARKNEST_OFFGRID=(
  "kakapo:8:4"
  # oliver (9) retired 2026-10-26 (disk lost); rebuilt as maxq
  "maxq:11:8"
  "cassowary:10:4"
)
# Native arm64 build host (source is synced here and built with brew's cargo);
# override with SPARKNEST_ARM_BUILDER=rhea when ostrich is busy.
SPARKNEST_ARM_BUILDER=${SPARKNEST_ARM_BUILDER:-ostrich}
SPARKNEST_ARM_BUILD_DIR='~/build/sparknest'
# Trial layout (see docs/ENVIRONMENT.md). `~` expands per host. These are
# user-owned so trials need no root; switch to /srv/sparknest-test and
# /mnt/sparknest-test once the root checklist has been run.
SPARKNEST_CLUSTER=trial
SPARKNEST_STATE_DIR='~/sparknest-test/state'
SPARKNEST_MOUNT='~/sparknest-test/mnt'
SPARKNEST_PORT=7410
SPARKNEST_API_PORT=7411
SPARKNEST_BIN_DIR='~/.local/lib/sparknest'
# Trial convenience: `cluster.sh start` bootstraps the first host when it has
# no Raft state. Never set this for a real cluster (use `cluster.sh bootstrap`).
SPARKNEST_AUTO_BOOTSTRAP=1
